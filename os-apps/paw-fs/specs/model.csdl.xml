<?xml version="1.0" encoding="utf-8"?>
<!--
  TemperFS — Governed File System on Temper Primitives
  OData v4 data model for workspaces, directories, files, and file versions.
-->
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>

    <Schema Namespace="Paw.Vocab" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <Term Name="StateMachine.States" Type="Collection(Edm.String)" AppliesTo="EntityType"/>
      <Term Name="StateMachine.InitialState" Type="Edm.String" AppliesTo="EntityType"/>
      <Term Name="StateMachine.ValidFromStates" Type="Collection(Edm.String)" AppliesTo="Action"/>
      <Term Name="StateMachine.TargetState" Type="Edm.String" AppliesTo="Action"/>
      <Term Name="Agent.Hint" Type="Edm.String" AppliesTo="Action Function EntityType"/>
      <Term Name="ShardKey" Type="Edm.String" AppliesTo="EntityType"/>
      <Term Name="AuthZ.CedarPolicy" Type="Edm.String" AppliesTo="EntityType Action Function"/>
      <Term Name="Relation.DeletePolicy" Type="Edm.String" AppliesTo="NavigationProperty"/>
    </Schema>

    <Schema Namespace="Paw.FS" xmlns="http://docs.oasis-open.org/odata/ns/edm">

      <!-- ============ Enums ============ -->

      <EnumType Name="WorkspaceStatus">
        <Member Name="Active" Value="0"/>
        <Member Name="Frozen" Value="1"/>
        <Member Name="Archived" Value="2"/>
      </EnumType>

      <EnumType Name="DirectoryStatus">
        <Member Name="Active" Value="0"/>
        <Member Name="Archived" Value="1"/>
      </EnumType>

      <EnumType Name="FileStatus">
        <Member Name="Created" Value="0"/>
        <Member Name="Ready" Value="1"/>
        <Member Name="Locked" Value="2"/>
        <Member Name="Archived" Value="3"/>
      </EnumType>

      <EnumType Name="FileVersionStatus">
        <Member Name="Current" Value="0"/>
        <Member Name="Superseded" Value="1"/>
        <Member Name="Orphaned" Value="2"/>
      </EnumType>

      <EnumType Name="ArtifactBatchStatus">
        <Member Name="Submitted" Value="0"/>
        <Member Name="Applying" Value="1"/>
        <Member Name="Completed" Value="2"/>
        <Member Name="Failed" Value="3"/>
      </EnumType>

      <EnumType Name="WorkspaceUsageBucketStatus">
        <Member Name="Active" Value="0"/>
        <Member Name="Sealed" Value="1"/>
      </EnumType>

      <!-- ============ Entity Types ============ -->

      <EntityType Name="Workspace">
        <Key><PropertyRef Name="Id"/></Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Name" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Paw.FS.WorkspaceStatus" Nullable="false"/>
        <Property Name="QuotaLimit" Type="Edm.Int64" DefaultValue="0"/>
        <Property Name="UsedBytes" Type="Edm.Int64" DefaultValue="0"/>
        <Property Name="FileCount" Type="Edm.Int32" DefaultValue="0"/>
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" Nullable="false"/>
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" Nullable="false"/>
        <NavigationProperty Name="Directories" Type="Collection(Paw.FS.Directory)"/>
        <NavigationProperty Name="Files" Type="Collection(Paw.FS.File)"/>
        <Annotation Term="Paw.Vocab.StateMachine.States">
          <Collection>
            <String>Active</String><String>Frozen</String><String>Archived</String>
          </Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.InitialState" String="Active"/>
        <Annotation Term="Paw.Vocab.ShardKey" String="Id"/>
        <Annotation Term="Paw.Vocab.AuthZ.CedarPolicy" String="policies/workspace.cedar"/>
      </EntityType>

      <EntityType Name="Directory">
        <Key><PropertyRef Name="Id"/></Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Name" Type="Edm.String" Nullable="false"/>
        <Property Name="Path" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Paw.FS.DirectoryStatus" Nullable="false"/>
        <Property Name="ParentId" Type="Edm.Guid"/>
        <Property Name="WorkspaceId" Type="Edm.Guid" Nullable="false"/>
        <Property Name="ItemCount" Type="Edm.Int32" DefaultValue="0"/>
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" Nullable="false"/>
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" Nullable="false"/>
        <NavigationProperty Name="Workspace" Type="Paw.FS.Workspace">
          <ReferentialConstraint Property="WorkspaceId" ReferencedProperty="Id"/>
        </NavigationProperty>
        <NavigationProperty Name="Parent" Type="Paw.FS.Directory">
          <ReferentialConstraint Property="ParentId" ReferencedProperty="Id"/>
        </NavigationProperty>
        <NavigationProperty Name="Children" Type="Collection(Paw.FS.Directory)"/>
        <NavigationProperty Name="Files" Type="Collection(Paw.FS.File)"/>
        <Annotation Term="Paw.Vocab.StateMachine.States">
          <Collection><String>Active</String><String>Archived</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.InitialState" String="Active"/>
        <Annotation Term="Paw.Vocab.ShardKey" String="WorkspaceId"/>
      </EntityType>

      <EntityType Name="File" HasStream="true">
        <Key><PropertyRef Name="Id"/></Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Name" Type="Edm.String" Nullable="false"/>
        <Property Name="Path" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Paw.FS.FileStatus" Nullable="false"/>
        <Property Name="DirectoryId" Type="Edm.Guid" Nullable="false"/>
        <Property Name="WorkspaceId" Type="Edm.Guid" Nullable="false"/>
        <Property Name="VersionCount" Type="Edm.Int32" DefaultValue="0"/>
        <Property Name="SizeBytes" Type="Edm.Int64" DefaultValue="0"/>
        <Property Name="HasContent" Type="Edm.Boolean" DefaultValue="false"/>
        <Property Name="ContentHash" Type="Edm.String"/>
        <Property Name="MimeType" Type="Edm.String"/>
        <Property Name="LastVersionId" Type="Edm.Guid"/>
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" Nullable="false"/>
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" Nullable="false"/>
        <NavigationProperty Name="Directory" Type="Paw.FS.Directory">
          <ReferentialConstraint Property="DirectoryId" ReferencedProperty="Id"/>
        </NavigationProperty>
        <NavigationProperty Name="Workspace" Type="Paw.FS.Workspace">
          <ReferentialConstraint Property="WorkspaceId" ReferencedProperty="Id"/>
        </NavigationProperty>
        <!-- A pointer to the newest version, not ownership: deleting a version
             leaves it as it is. -->
        <NavigationProperty Name="LastVersion" Type="Paw.FS.FileVersion">
          <ReferentialConstraint Property="LastVersionId" ReferencedProperty="Id"/>
          <Annotation Term="Paw.Vocab.Relation.DeletePolicy" String="none"/>
        </NavigationProperty>
        <NavigationProperty Name="Versions" Type="Collection(Paw.FS.FileVersion)"/>
        <Annotation Term="Paw.Vocab.StateMachine.States">
          <Collection>
            <String>Created</String><String>Ready</String>
            <String>Locked</String><String>Archived</String>
          </Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.InitialState" String="Created"/>
        <Annotation Term="Paw.Vocab.ShardKey" String="WorkspaceId"/>
        <Annotation Term="Paw.Vocab.AuthZ.CedarPolicy" String="policies/file.cedar"/>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="File entity with binary stream support. Use PUT $value to upload content, GET $value to download."/>
      </EntityType>

      <EntityType Name="FileVersion">
        <Key><PropertyRef Name="Id"/></Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false"/>
        <Property Name="file_id" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Status" Type="Paw.FS.FileVersionStatus" Nullable="false"/>
        <Property Name="VersionNumber" Type="Edm.Int32" Nullable="false"/>
        <Property Name="ContentHash" Type="Edm.String" Nullable="false"/>
        <Property Name="MimeType" Type="Edm.String" Nullable="false"/>
        <Property Name="SizeBytes" Type="Edm.Int64" Nullable="false"/>
        <Property Name="PreviousVersionId" Type="Edm.Guid"/>
        <Property Name="CreatedBy" Type="Edm.String"/>
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" Nullable="false"/>
        <!-- A version belongs to its File: deleting the File deletes its versions.
             file_id is the field FileVersion stores. -->
        <NavigationProperty Name="File" Type="Paw.FS.File">
          <ReferentialConstraint Property="file_id" ReferencedProperty="Id"/>
          <Annotation Term="Paw.Vocab.Relation.DeletePolicy" String="cascade"/>
        </NavigationProperty>
        <!-- The version before this one, in the same File. The versions are
             deleted with their File, so this link needs no delete rule. -->
        <NavigationProperty Name="PreviousVersion" Type="Paw.FS.FileVersion">
          <ReferentialConstraint Property="PreviousVersionId" ReferencedProperty="Id"/>
          <Annotation Term="Paw.Vocab.Relation.DeletePolicy" String="none"/>
        </NavigationProperty>
        <Annotation Term="Paw.Vocab.StateMachine.States">
          <Collection><String>Current</String><String>Superseded</String><String>Orphaned</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.InitialState" String="Current"/>
        <Annotation Term="Paw.Vocab.ShardKey" String="file_id"/>
        <Annotation Term="Paw.Vocab.AuthZ.CedarPolicy" String="policies/file_version.cedar"/>
      </EntityType>

      <EntityType Name="ArtifactBatch">
        <Key><PropertyRef Name="Id"/></Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Status" Type="Paw.FS.ArtifactBatchStatus" Nullable="false"/>
        <Property Name="WorkspaceId" Type="Edm.Guid" Nullable="false"/>
        <Property Name="FilesManifest" Type="Edm.String"/>
        <Property Name="FileCount" Type="Edm.Int32" DefaultValue="0"/>
        <Property Name="AppliedCount" Type="Edm.Int32" DefaultValue="0"/>
        <Property Name="FailedCount" Type="Edm.Int32" DefaultValue="0"/>
        <Property Name="TotalBytes" Type="Edm.Int64" DefaultValue="0"/>
        <Property Name="LastError" Type="Edm.String"/>
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" Nullable="false"/>
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" Nullable="false"/>
        <Annotation Term="Paw.Vocab.StateMachine.States">
          <Collection><String>Submitted</String><String>Applying</String><String>Completed</String><String>Failed</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.InitialState" String="Submitted"/>
        <Annotation Term="Paw.Vocab.ShardKey" String="WorkspaceId"/>
        <Annotation Term="Paw.Vocab.AuthZ.CedarPolicy" String="policies/artifact_batch.cedar"/>
      </EntityType>

      <EntityType Name="WorkspaceUsageBucket">
        <Key><PropertyRef Name="Id"/></Key>
        <Property Name="Id" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Status" Type="Paw.FS.WorkspaceUsageBucketStatus" Nullable="false"/>
        <Property Name="WorkspaceId" Type="Edm.Guid" Nullable="false"/>
        <Property Name="BucketKey" Type="Edm.String" Nullable="false"/>
        <Property Name="ArtifactBatchId" Type="Edm.Guid"/>
        <Property Name="BytesDelta" Type="Edm.Int64" DefaultValue="0"/>
        <Property Name="FileDelta" Type="Edm.Int64" DefaultValue="0"/>
        <Property Name="CreatedAt" Type="Edm.DateTimeOffset" Nullable="false"/>
        <Property Name="UpdatedAt" Type="Edm.DateTimeOffset" Nullable="false"/>
        <Annotation Term="Paw.Vocab.StateMachine.States">
          <Collection><String>Active</String><String>Sealed</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.InitialState" String="Active"/>
        <Annotation Term="Paw.Vocab.ShardKey" String="WorkspaceId"/>
        <Annotation Term="Paw.Vocab.AuthZ.CedarPolicy" String="policies/workspace_usage_bucket.cedar"/>
      </EntityType>

      <!-- ============ Bound Actions ============ -->

      <!-- Workspace Actions -->
      <Action Name="UpdateQuota" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <Parameter Name="quota_limit" Type="Edm.Int64" Nullable="false"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
      </Action>

      <Action Name="IncrementUsage" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <Parameter Name="size_bytes" Type="Edm.Int64" Nullable="false"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
      </Action>

      <Action Name="DecrementUsage" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <Parameter Name="size_bytes" Type="Edm.Int64" Nullable="false"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
      </Action>

      <Action Name="Freeze" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.TargetState" String="Frozen"/>
      </Action>

      <Action Name="Thaw" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Frozen</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.TargetState" String="Active"/>
      </Action>

      <Action Name="WorkspaceArchive" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String><String>Frozen</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.TargetState" String="Archived"/>
      </Action>

      <!-- Filesystem Actions (FUSE-mapped, bound to Workspace) -->
      <Action Name="MkDir" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <Parameter Name="path" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="Create directory hierarchy at path (mkdir -p). WASM resolves and creates intermediate directories."/>
      </Action>

      <Action Name="CreateFile" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <Parameter Name="path" Type="Edm.String" Nullable="false"/>
        <Parameter Name="mime_type" Type="Edm.String"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="Create file entity at path (creat). Returns file_id in workspace state. Upload content separately via PUT $value."/>
      </Action>

      <Action Name="ResolvePath" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <Parameter Name="path" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="Resolve path to file entity (stat). Returns file_id in workspace state."/>
      </Action>

      <Action Name="ListDir" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <Parameter Name="path" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="List directory contents at path (readdir). Returns JSON listing in workspace state."/>
      </Action>

      <Action Name="DeleteFile" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <Parameter Name="path" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="Archive file at path (unlink). Dispatches FileArchive on the resolved file entity."/>
      </Action>

      <Action Name="Rename" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Workspace"/>
        <Parameter Name="path" Type="Edm.String" Nullable="false"/>
        <Parameter Name="new_path" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Paw.FS.Workspace"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="Rename/move file from path to new_path (rename). Creates intermediate directories for new_path."/>
      </Action>

      <!-- Directory Actions -->
      <Action Name="AddChild" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Directory"/>
        <ReturnType Type="Paw.FS.Directory"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
      </Action>

      <Action Name="RemoveChild" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Directory"/>
        <ReturnType Type="Paw.FS.Directory"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
      </Action>

      <Action Name="DirectoryRename" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Directory"/>
        <Parameter Name="name" Type="Edm.String" Nullable="false"/>
        <Parameter Name="path" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Paw.FS.Directory"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
      </Action>

      <Action Name="DirectoryArchive" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.Directory"/>
        <ReturnType Type="Paw.FS.Directory"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Active</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.TargetState" String="Archived"/>
      </Action>

      <!-- File Actions -->
      <Action Name="StreamUpdated" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.File"/>
        <Parameter Name="content_hash" Type="Edm.String" Nullable="false"/>
        <Parameter Name="size_bytes" Type="Edm.Int64" Nullable="false"/>
        <Parameter Name="mime_type" Type="Edm.String" Nullable="false"/>
        <Parameter Name="version_number" Type="Edm.Int32" Nullable="false"/>
        <Parameter Name="previous_version_id" Type="Edm.Guid"/>
        <Parameter Name="created_by" Type="Edm.String"/>
        <ReturnType Type="Paw.FS.File"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Created</String><String>Ready</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.TargetState" String="Ready"/>
        <Annotation Term="Paw.Vocab.Agent.Hint" String="Fired by $value PUT handler after WASM blob upload succeeds. Not directly callable by agents."/>
      </Action>

      <Action Name="Lock" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.File"/>
        <ReturnType Type="Paw.FS.File"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Ready</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.TargetState" String="Locked"/>
      </Action>

      <Action Name="Unlock" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.File"/>
        <ReturnType Type="Paw.FS.File"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Locked</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.TargetState" String="Ready"/>
      </Action>

      <Action Name="FileArchive" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.File"/>
        <ReturnType Type="Paw.FS.File"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Ready</String><String>Locked</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.TargetState" String="Archived"/>
      </Action>

      <Action Name="RecordVersion" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.File"/>
        <Parameter Name="last_version_id" Type="Edm.Guid" Nullable="false"/>
        <ReturnType Type="Paw.FS.File"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Created</String><String>Ready</String><String>Locked</String></Collection>
        </Annotation>
      </Action>

      <!-- FileVersion Actions -->
      <Action Name="Supersede" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.FileVersion"/>
        <ReturnType Type="Paw.FS.FileVersion"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Current</String><String>Superseded</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.TargetState" String="Superseded"/>
      </Action>
      <Action Name="Orphan" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.FileVersion"/>
        <ReturnType Type="Paw.FS.FileVersion"/>
        <Annotation Term="Paw.Vocab.StateMachine.ValidFromStates">
          <Collection><String>Current</String><String>Superseded</String></Collection>
        </Annotation>
        <Annotation Term="Paw.Vocab.StateMachine.TargetState" String="Orphaned"/>
      </Action>

      <!-- ArtifactBatch Actions -->
      <Action Name="Submit" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.ArtifactBatch"/>
        <Parameter Name="workspace_id" Type="Edm.Guid" Nullable="false"/>
        <Parameter Name="files_manifest" Type="Edm.String" Nullable="false"/>
        <Parameter Name="submitted_by" Type="Edm.String"/>
        <Parameter Name="file_count" Type="Edm.Int32"/>
        <ReturnType Type="Paw.FS.ArtifactBatch"/>
      </Action>

      <Action Name="Apply" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.ArtifactBatch"/>
        <ReturnType Type="Paw.FS.ArtifactBatch"/>
      </Action>

      <Action Name="RecordFileApplied" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.ArtifactBatch"/>
        <Parameter Name="path" Type="Edm.String" Nullable="false"/>
        <Parameter Name="file_id" Type="Edm.Guid" Nullable="false"/>
        <Parameter Name="size_bytes" Type="Edm.Int64" Nullable="false"/>
        <ReturnType Type="Paw.FS.ArtifactBatch"/>
      </Action>

      <Action Name="RecordFileFailed" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.ArtifactBatch"/>
        <Parameter Name="path" Type="Edm.String" Nullable="false"/>
        <Parameter Name="error" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Paw.FS.ArtifactBatch"/>
      </Action>

      <Action Name="Complete" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.ArtifactBatch"/>
        <Parameter Name="usage_bucket_id" Type="Edm.Guid"/>
        <ReturnType Type="Paw.FS.ArtifactBatch"/>
      </Action>

      <Action Name="Fail" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.ArtifactBatch"/>
        <Parameter Name="error" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Paw.FS.ArtifactBatch"/>
      </Action>

      <!-- WorkspaceUsageBucket Actions -->
      <Action Name="ApplyDelta" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.WorkspaceUsageBucket"/>
        <Parameter Name="workspace_id" Type="Edm.Guid" Nullable="false"/>
        <Parameter Name="bucket_key" Type="Edm.String" Nullable="false"/>
        <Parameter Name="artifact_batch_id" Type="Edm.Guid"/>
        <Parameter Name="bytes_delta" Type="Edm.Int64" Nullable="false"/>
        <Parameter Name="file_delta" Type="Edm.Int64" Nullable="false"/>
        <ReturnType Type="Paw.FS.WorkspaceUsageBucket"/>
      </Action>

      <Action Name="Seal" IsBound="true">
        <Parameter Name="bindingParameter" Type="Paw.FS.WorkspaceUsageBucket"/>
        <ReturnType Type="Paw.FS.WorkspaceUsageBucket"/>
      </Action>

      <!-- ============ Entity Container ============ -->

      <EntityContainer Name="TemperFSService">
        <EntitySet Name="Workspaces" EntityType="Paw.FS.Workspace">
          <NavigationPropertyBinding Path="Directories" Target="Directories"/>
          <NavigationPropertyBinding Path="Files" Target="Files"/>
        </EntitySet>
        <EntitySet Name="Directories" EntityType="Paw.FS.Directory">
          <NavigationPropertyBinding Path="Workspace" Target="Workspaces"/>
          <NavigationPropertyBinding Path="Parent" Target="Directories"/>
          <NavigationPropertyBinding Path="Children" Target="Directories"/>
          <NavigationPropertyBinding Path="Files" Target="Files"/>
        </EntitySet>
        <EntitySet Name="Files" EntityType="Paw.FS.File">
          <NavigationPropertyBinding Path="Directory" Target="Directories"/>
          <NavigationPropertyBinding Path="Workspace" Target="Workspaces"/>
